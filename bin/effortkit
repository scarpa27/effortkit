#!/usr/bin/env python3
"""The kit command: install an instance, start the installer agent, check a config, list the instances."""
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(os.path.realpath(__file__)).parents[1] / "lib"))
from effortkit import kitcli  # noqa: E402

if __name__ == "__main__":
    kitcli.main(sys.argv[1:])
